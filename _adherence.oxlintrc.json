{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badge/**",
              "components/core/**",
              "components/icons/**",
              "components/status/**",
              "ui_kits/talent-club-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:YekanBakhFaNum|YekanBakh|IRANYekanX|Gilroy))/i]",
        "message": "Font not provided by the design system. Available: YekanBakhFaNum, YekanBakh, IRANYekanX, Gilroy."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLeft'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<ArrowLeft> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowUp'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<ArrowUp> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg)$/]",
        "message": "<Avatar> size must be one of 'xs' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|brand|neutral)$/]",
        "message": "<Avatar> tone must be one of 'accent' | 'brand' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|size|icon|type|color|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: className, style, size, icon, type, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:false|dot|x close|avatar|icon right|icon left)$/]",
        "message": "<Badge> icon must be one of 'false' | 'dot' | 'x close' | 'avatar' | 'icon right' | 'icon left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:pill outline|pill color|badge color|badge modern)$/]",
        "message": "<Badge> type must be one of 'pill outline' | 'pill color' | 'badge color' | 'badge modern'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:primary|error|warning|success|blue light|blue|indigo|purple|pink|rosé|orange|blue gray|gray)$/]",
        "message": "<Badge> color must be one of 'primary' | 'error' | 'warning' | 'success' | 'blue light' | 'blue' | 'indigo' | 'purple' | 'pink' | 'rosé' | 'orange' | 'blue gray' | 'gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgeBase'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|flagSwap|icon|text1|icon1|key|ref|className|style|children)$/]",
        "message": "<BadgeBase> doesn't accept that prop. Declared props: className, style, flagSwap, icon, text1, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgeBase'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:false|dot|x close|avatar|icon right|icon left|only)$/]",
        "message": "<BadgeBase> icon must be one of 'false' | 'dot' | 'x close' | 'avatar' | 'icon right' | 'icon left' | 'only'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgeDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|size|outline|key|ref|className|style|children)$/]",
        "message": "<BadgeDot> doesn't accept that prop. Declared props: className, style, size, outline."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgeDot'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg|md)$/]",
        "message": "<BadgeDot> size must be one of 'sm' | 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|hierarchy|size|destructive|disabled|loading|loadingText|iconLeft|iconRight|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, hierarchy, size, destructive, disabled, loading, loadingText, iconLeft, iconRight, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='hierarchy'] > Literal[value!=/^(?:contained|pale|ai|outline|text1|text2|primary|secondary|tertiary|link|light)$/]",
        "message": "<Button> hierarchy must be one of 'contained' | 'pale' | 'ai' | 'outline' | 'text1' | 'text2' | 'primary' | 'secondary' | 'tertiary' | 'link' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dot'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|outline|key|ref|className|style|children)$/]",
        "message": "<Dot> doesn't accept that prop. Declared props: size, color, outline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dot'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Dot> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dot'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:gray|brand|error|warning|success|blue|violet)$/]",
        "message": "<Dot> color must be one of 'gray' | 'brand' | 'error' | 'warning' | 'success' | 'blue' | 'violet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tone|active|disabled|label|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, size, tone, active, disabled, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted|accent)$/]",
        "message": "<IconButton> tone must be one of 'default' | 'muted' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plus'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Plus> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='XClose'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<XClose> doesn't accept that prop. Declared props: className, style."
      }
    ]
  },
